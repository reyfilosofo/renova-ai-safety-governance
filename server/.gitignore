# .gitignore — MCP ℛenova
# No subir estado local, entornos virtuales ni salidas de build.
# El corpus (staging 104 KB; Biblioteca ~14 MB en vercel-deploy/corpus/)
# NO se sube como texto del repo salvo por la vía documentada en
# vercel-deploy/README-DEPLOY.md (la Biblioteca no está en el repo por
# tamaño y derechos; el servidor degrada con gracia sin ella).

# Bytecode y cachés de Python
__pycache__/
*.pyc
*.pyo
*$py.class

# Estado local del servidor (se crea al usarlo; no es contenido)
data/
server.pid
server.log
*.log

# Credenciales y entorno (no hay ninguna en este paquete; por si acaso)
.env
*.env
*.pem
*.key

# Entornos virtuales
.venv/
venv/
ENV/

# Implementación FastMCP archivada (38 MB con su venv; alternativa, no canónica)
archive-fastmcp/

# Salida de build del despliegue Vercel (la regenera build.sh) y su caché
vercel-deploy/corpus/
vercel-deploy/__pycache__/

# Directorio de staging de sincronización (artefactos del push, no contenido)
vercel-push-staging/

# Sistema
.DS_Store
Thumbs.db
